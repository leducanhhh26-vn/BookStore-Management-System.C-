<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? t + " – " : "")BookStore – Nhà sách trực tuyến</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header sticky-top">
        <div class="topbar d-none d-md-block">
            <div class="container d-flex justify-content-between">
                <span><i class="bi bi-truck"></i> Miễn phí vận chuyển cho đơn từ 300.000 ₫</span>
                <span><i class="bi bi-telephone"></i> Hotline 1900 6656 · <i class="bi bi-clock"></i> 8:00 – 21:00</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i> Book<span>Store</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-2">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-grid"></i> Danh mục</a>
                            @await Component.InvokeAsync("CategoryMenu")
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index" asp-route-sort="BestSelling">Bán chạy</a></li>
                    </ul>
                    <form class="search-box flex-grow-1 my-2 my-lg-0" asp-controller="Books" asp-action="Index" method="get" role="search">
                        <i class="bi bi-search"></i>
                        <input class="form-control" type="search" name="q" value="@Context.Request.Query["q"]"
                               placeholder="Tìm tên sách, tác giả, nhà xuất bản..." aria-label="Tìm kiếm" />
                    </form>
                    <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag"></i> Giỏ hàng
                                <span class="cart-badge">@await Component.InvokeAsync("CartCount")</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> Tài khoản của tôi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses"><i class="bi bi-geo-alt"></i> Sổ địa chỉ</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-person"></i> Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="pb-5">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="brand mb-2"><i class="bi bi-book-half"></i> Book<span>Store</span></div>
                    <p class="small mb-0">Nhà sách trực tuyến – Đồ án môn Lập trình C#, Nhóm 13, Khoa Công nghệ Thông tin, Trường Đại học Sài Gòn.</p>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Mua sắm</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Books" asp-action="Index">Tất cả sách</a></li>
                        <li><a asp-controller="Books" asp-action="Index" asp-route-sort="BestSelling">Sách bán chạy</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Hỗ trợ</h6>
                    <ul class="list-unstyled small">
                        <li>Thanh toán khi nhận hàng (COD)</li>
                        <li>Chuyển khoản ngân hàng</li>
                        <li>Đổi trả trong 7 ngày</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Liên hệ</h6>
                    <p class="small mb-0"><i class="bi bi-geo-alt"></i> 273 An Dương Vương, Phường 3, Quận 5, TP.HCM<br /><i class="bi bi-envelope"></i> hotro@bookstore.vn</p>
                </div>
            </div>
            <div class="text-center small mt-4 opacity-75">© @DateTime.Now.Year BookStore – Nhóm 13</div>
        </div>
    </footer>

    @* Thông báo toast (thành công / lỗi) sau mỗi thao tác *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (TempData[ToastExtensions.Key] is string toastJson)
        {
            var toast = System.Text.Json.JsonSerializer.Deserialize<ToastMessage>(toastJson)!;
            <div class="toast align-items-center text-bg-@(toast.Success ? "success" : "danger") border-0 show" role="alert" data-autohide="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi @(toast.Success ? "bi-check-circle" : "bi-exclamation-triangle")"></i> @toast.Message</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

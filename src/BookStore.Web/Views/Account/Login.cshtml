@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="container auth-page">
    <div class="auth-card">
        <h1 class="h4 text-center mb-1">Đăng nhập</h1>
        <p class="text-center text-muted small mb-4">Chào mừng bạn quay lại BookStore</p>
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Login" class="form-label"></label>
                <input asp-for="Login" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Login" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
            </div>
            <button class="btn btn-primary w-100 btn-lg">Đăng nhập</button>
        </form>
        <p class="text-center small mt-3 mb-0">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        <div class="demo-hint small mt-3">
            <i class="bi bi-info-circle"></i> Tài khoản dùng thử: <code>khachhang1</code> / <code>Khach@123</code>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

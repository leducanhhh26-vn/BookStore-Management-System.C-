@{
    ViewData["Title"] = "Lỗi";
}
<div class="container py-5 text-center">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="h3 mt-3">Đã xảy ra lỗi khi xử lý yêu cầu</h1>
    <p class="text-muted">Vui lòng thử lại sau ít phút. Nếu lỗi vẫn tiếp diễn, hãy liên hệ bộ phận hỗ trợ.</p>
    <p class="small text-muted">Mã yêu cầu: @ViewBag.RequestId</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>

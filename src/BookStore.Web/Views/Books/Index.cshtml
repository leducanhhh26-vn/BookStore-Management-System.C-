@model BookListViewModel
@{
    ViewData["Title"] = Model.Heading;
    var priceRanges = new (string Label, decimal? Min, decimal? Max)[]
    {
        ("Tất cả mức giá", null, null), ("Dưới 50.000 ₫", null, 50000), ("50.000 – 100.000 ₫", 50000, 100000),
        ("100.000 – 200.000 ₫", 100000, 200000), ("Trên 200.000 ₫", 200000, null)
    };
    var sorts = new (BookSort Value, string Label)[]
    {
        (BookSort.Newest, "Mới nhất"), (BookSort.BestSelling, "Bán chạy"), (BookSort.PriceAsc, "Giá tăng dần"),
        (BookSort.PriceDesc, "Giá giảm dần"), (BookSort.TitleAsc, "Tên A → Z")
    };
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">@Model.Heading</li>
        </ol>
    </nav>

    <div class="row g-4">
        @* ---------------- Bộ lọc ---------------- *@
        <aside class="col-lg-3">
            <form method="get" asp-action="Index" class="filter-panel" id="filterForm">
                <input type="hidden" name="q" value="@Model.Q" />
                <input type="hidden" name="sort" value="@Model.Sort" />

                <h6>Thể loại</h6>
                <div class="list-group list-group-flush mb-3">
                    <label class="filter-option">
                        <input type="radio" name="categoryId" value="" @(Model.CategoryId == null ? "checked" : "") onchange="this.form.submit()" /> Tất cả
                    </label>
                    @foreach (var c in Model.Categories)
                    {
                        <label class="filter-option">
                            <input type="radio" name="categoryId" value="@c.Id" @(Model.CategoryId == c.Id ? "checked" : "") onchange="this.form.submit()" />
                            @c.Name <span class="text-muted small">(@c.BookCount)</span>
                        </label>
                    }
                </div>

                <h6>Khoảng giá</h6>
                <div class="mb-2">
                    @foreach (var r in priceRanges)
                    {
                        var active = Model.MinPrice == r.Min && Model.MaxPrice == r.Max;
                        <label class="filter-option">
                            <input type="radio" name="priceRange" value="@(r.Min)-@(r.Max)" @(active ? "checked" : "") data-min="@r.Min" data-max="@r.Max" /> @r.Label
                        </label>
                    }
                </div>
                <div class="d-flex gap-2 mb-3">
                    <input class="form-control form-control-sm" type="number" min="0" step="1000" name="minPrice" value="@Model.MinPrice?.ToString("0")" placeholder="Từ" aria-label="Giá từ" />
                    <input class="form-control form-control-sm" type="number" min="0" step="1000" name="maxPrice" value="@Model.MaxPrice?.ToString("0")" placeholder="Đến" aria-label="Giá đến" />
                </div>

                <h6>Nhà xuất bản</h6>
                <select class="form-select form-select-sm mb-3" name="publisherId" onchange="this.form.submit()" aria-label="Nhà xuất bản">
                    <option value="">Tất cả nhà xuất bản</option>
                    @foreach (var p in Model.Publishers)
                    {
                        <option value="@p.Id" selected="@(Model.PublisherId == p.Id)">@p.Name</option>
                    }
                </select>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="inStock" value="true" id="inStock" @(Model.InStock ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="inStock">Chỉ hiện sách còn hàng</label>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel"></i> Áp dụng</button>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Xóa lọc</a>
                </div>
            </form>
        </aside>

        @* ---------------- Danh sách ---------------- *@
        <section class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h1 class="h4 mb-0">@Model.Heading</h1>
                    <span class="text-muted small">@Model.Result.TotalCount đầu sách</span>
                </div>
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    @foreach (var kv in Model.RouteFor(1).Where(kv => kv.Key != "sort" && kv.Key != "page" && kv.Value != null))
                    {
                        <input type="hidden" name="@kv.Key" value="@kv.Value" />
                    }
                    <label class="small text-muted text-nowrap" for="sortSelect">Sắp xếp</label>
                    <select id="sortSelect" class="form-select form-select-sm" name="sort" onchange="this.form.submit()">
                        @foreach (var s in sorts)
                        {
                            <option value="@s.Value" selected="@(Model.Sort == s.Value)">@s.Label</option>
                        }
                    </select>
                </form>
            </div>

            @if (Model.Result.Items.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h5>Không tìm thấy sản phẩm nào phù hợp</h5>
                    <p class="text-muted">Hãy thử từ khóa khác, bỏ bớt bộ lọc hoặc xem tất cả sách.</p>
                    <a class="btn btn-primary" asp-action="Index">Xem tất cả sách</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var b in Model.Result.Items)
                    {
                        <div class="col-6 col-md-4"><partial name="_BookCard" model="b" /></div>
                    }
                </div>

                @if (Model.Result.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Phân trang">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(Model.Result.Page - 1)" aria-label="Trang trước">&laquo;</a>
                            </li>
                            @for (int p = 1; p <= Model.Result.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(p)">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(Model.Result.Page + 1)" aria-label="Trang sau">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Chọn khoảng giá có sẵn → điền vào ô Từ/Đến rồi lọc
        document.querySelectorAll('input[name="priceRange"]').forEach(r => r.addEventListener('change', () => {
            const f = document.getElementById('filterForm');
            f.minPrice.value = r.dataset.min || '';
            f.maxPrice.value = r.dataset.max || '';
            f.submit();
        }));
    </script>
}

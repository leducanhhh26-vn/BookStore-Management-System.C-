@model AddressViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm địa chỉ" : "Sửa địa chỉ";
}
<div class="container mt-4">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_AccountNav" /></div>
        <div class="col-lg-9">
            <div class="card-surface p-4">
                <h1 class="h5 mb-3">@ViewData["Title"]</h1>
                <form asp-action="AddressForm" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ReceiverName" class="form-label"></label>
                            <input asp-for="ReceiverName" class="form-control" />
                            <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" type="tel" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label"></label>
                            <input asp-for="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Ward" class="form-label"></label>
                            <input asp-for="Ward" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="District" class="form-label"></label>
                            <input asp-for="District" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" />
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="col-12 form-check ms-1">
                            <input asp-for="IsDefault" class="form-check-input" />
                            <label asp-for="IsDefault" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary">Lưu địa chỉ</button>
                        <a class="btn btn-outline-secondary" href="@(Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Addresses"))">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

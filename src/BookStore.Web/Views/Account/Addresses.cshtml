@model List<AddressDto>
@{
    ViewData["Title"] = "Sổ địa chỉ";
}
<div class="container mt-4">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_AccountNav" /></div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h5 mb-0">Sổ địa chỉ nhận hàng</h1>
                <a class="btn btn-primary btn-sm" asp-action="AddressForm"><i class="bi bi-plus-lg"></i> Thêm địa chỉ</a>
            </div>
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-geo-alt"></i>
                    <h5>Bạn chưa có địa chỉ nào</h5>
                    <p class="text-muted">Thêm địa chỉ để đặt hàng nhanh hơn.</p>
                    <a class="btn btn-primary" asp-action="AddressForm">Thêm địa chỉ</a>
                </div>
            }
            @foreach (var a in Model)
            {
                <div class="card-surface p-3 mb-3 d-flex flex-wrap justify-content-between gap-3">
                    <div>
                        <div class="fw-semibold">
                            @a.ReceiverName <span class="text-muted fw-normal">| @a.Phone</span>
                            @if (a.IsDefault)
                            {
                                <span class="badge text-bg-primary ms-1">Mặc định</span>
                            }
                        </div>
                        <div class="text-muted small">@a.FullAddress</div>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="AddressForm" asp-route-id="@a.Id">Sửa</a>
                        @if (!a.IsDefault)
                        {
                            <form asp-action="SetDefaultAddress" asp-route-id="@a.Id" method="post">
                                <button class="btn btn-sm btn-outline-primary">Đặt mặc định</button>
                            </form>
                        }
                        <form asp-action="DeleteAddress" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Xóa địa chỉ này?');">
                            <button class="btn btn-sm btn-outline-danger" aria-label="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
